generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model admin_action {
  action_id                                Int       @id @default(autoincrement())
  admin_id                                 Int?
  target_user_id                           Int?
  action_type                              String?   @db.VarChar(50)
  action_description                       String?
  timestamp                                DateTime? @default(now()) @db.Timestamp(6)
  users_admin_action_admin_idTousers       users?    @relation("admin_action_admin_idTousers", fields: [admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_admin_action_target_user_idTousers users?    @relation("admin_action_target_user_idTousers", fields: [target_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model booking {
  booking_id      Int               @id @default(autoincrement())
  tourist_id      Int?
  guide_id        Int?
  hotel_id        Int?
  start_date      DateTime?         @db.Date
  end_date        DateTime?         @db.Date
  status          String?           @db.VarChar(50)
  total_price     Decimal?          @db.Decimal(10, 2)
  guide           guide?            @relation(fields: [guide_id], references: [guide_id], onDelete: NoAction, onUpdate: NoAction)
  hotel           hotel?            @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction)
  tourist         tourist?          @relation(fields: [tourist_id], references: [tourist_id], onDelete: NoAction, onUpdate: NoAction)
  incident_report incident_report[]
}

model guide {
  guide_id          Int       @id
  bio               String?
  experience_years  Int?
  experience_label  String?   @db.VarChar(50)
  specialization    String?   @db.VarChar(150)
  languages         String?
  license_number    String?   @db.VarChar(100)
  license_document  String?
  verified_status   Boolean?  @default(false)
  is_available      Boolean?  @default(true)
  booking           booking[]
  destination_request destination_request[]
  guide_destination guide_destination[]
  users             users     @relation(fields: [guide_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  review            review[]
}

model hotel {
  hotel_id             Int       @id
  hotel_name           String?   @db.VarChar(200)
  location             String?   @db.VarChar(200)
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  registration_number  String?   @db.VarChar(120)
  license_document     String?
  description          String?
  rating               Float?
  verified_status      Boolean?  @default(false)
  base_price           Decimal?  @db.Decimal(10, 2)
  images               String?
  room_details         String?
  facilities           String?
  booking              booking[]
  users                users     @relation(fields: [hotel_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  review               review[]
}

model incident_report {
  incident_id   Int       @id @default(autoincrement())
  tourist_id    Int?
  booking_id    Int?
  incident_type String?   @db.VarChar(50)
  details       String?
  location      String?   @db.VarChar(200)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  booking       booking?  @relation(fields: [booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction)
  tourist       tourist?  @relation(fields: [tourist_id], references: [tourist_id], onDelete: NoAction, onUpdate: NoAction)
}

model review {
  review_id  Int       @id @default(autoincrement())
  tourist_id Int?
  guide_id   Int?
  hotel_id   Int?
  rating     Int?
  comment    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  guide      guide?    @relation(fields: [guide_id], references: [guide_id], onDelete: NoAction, onUpdate: NoAction)
  hotel      hotel?    @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction)
  tourist    tourist?  @relation(fields: [tourist_id], references: [tourist_id], onDelete: NoAction, onUpdate: NoAction)
}

model sos_report {
  report_id   Int       @id @default(autoincrement())
  tourist_id  Int?
  location    String?   @db.VarChar(200)
  timestamp   DateTime? @default(now()) @db.Timestamp(6)
  description String?
  status      String?   @db.VarChar(30)
  tourist     tourist?  @relation(fields: [tourist_id], references: [tourist_id], onDelete: NoAction, onUpdate: NoAction)
}

model tourist {
  tourist_id        Int               @id
  emergency_contact String?           @db.VarChar(100)
  preferences       String?
  saved_places      String?
  payment_methods   String?
  privacy_settings  String?
  booking           booking[]
  incident_report   incident_report[]
  review            review[]
  sos_report        sos_report[]
  users             users             @relation(fields: [tourist_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model notification {
  notification_id Int       @id @default(autoincrement())
  user_id         Int
  title           String    @db.VarChar(120)
  message         String
  type            String?   @db.VarChar(40)
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model destination {
  destination_id      Int                   @id @default(autoincrement())
  name                String                @db.VarChar(160)
  location            String                @db.VarChar(255)
  latitude            Decimal?              @db.Decimal(10, 7)
  longitude           Decimal?              @db.Decimal(10, 7)
  description         String?
  image               String?
  category            String?               @db.VarChar(120)
  popularity_score    Float?
  difficulty          String?               @db.VarChar(80)
  duration            String?               @db.VarChar(80)
  best_time           String?               @db.VarChar(120)
  price_per_day_npr   Int?
  activities          String?
  highlights          String?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @updatedAt @db.Timestamp(6)
  destination_request destination_request[] @relation("approved_destination")
  guide_destination   guide_destination[]
}

model guide_destination {
  id             Int         @id @default(autoincrement())
  guide_id       Int
  destination_id Int
  destination    destination @relation(fields: [destination_id], references: [destination_id], onDelete: Cascade, onUpdate: NoAction)
  guide          guide       @relation(fields: [guide_id], references: [guide_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([guide_id, destination_id])
}

model destination_request {
  request_id               Int          @id @default(autoincrement())
  guide_id                 Int?
  requester_name           String?      @db.VarChar(160)
  requester_email          String?      @db.VarChar(255)
  destination_name         String       @db.VarChar(160)
  location                 String       @db.VarChar(255)
  reason                   String
  image                    String?
  latitude                 Decimal?     @db.Decimal(10, 7)
  longitude                Decimal?     @db.Decimal(10, 7)
  status                   String       @default("pending") @db.VarChar(40)
  rejection_reason         String?
  created_at               DateTime?    @default(now()) @db.Timestamp(6)
  reviewed_at              DateTime?    @db.Timestamp(6)
  approved_destination_id  Int?
  destination_approved     destination? @relation("approved_destination", fields: [approved_destination_id], references: [destination_id], onDelete: SetNull, onUpdate: NoAction)
  guide                    guide?       @relation(fields: [guide_id], references: [guide_id], onDelete: SetNull, onUpdate: NoAction)
}

model message {
  message_id               Int       @id @default(autoincrement())
  sender_id                Int
  receiver_id              Int
  content                  String
  is_read                  Boolean?  @default(false)
  sent_at                  DateTime? @default(now()) @db.Timestamp(6)
  users_message_receiver   users     @relation("message_receiver", fields: [receiver_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  users_message_sender     users     @relation("message_sender", fields: [sender_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  user_id                                         Int            @id @default(autoincrement())
  full_name                                       String         @db.VarChar(150)
  username                                        String?        @unique @db.VarChar(80)
  email                                           String         @unique @db.VarChar(255)
  password                                        String         @db.VarChar(255)
  profile_photo                                   String?
  phone                                           String?        @db.VarChar(50)
  role                                            String         @db.VarChar(20)
  created_at                                      DateTime?      @default(now()) @db.Timestamp(6)
  admin_action_admin_action_admin_idTousers       admin_action[] @relation("admin_action_admin_idTousers")
  admin_action_admin_action_target_user_idTousers admin_action[] @relation("admin_action_target_user_idTousers")
  message_message_receiver                        message[]      @relation("message_receiver")
  message_message_sender                          message[]      @relation("message_sender")
  notification                                    notification[]
  guide                                           guide?
  hotel                                           hotel?
  tourist                                         tourist?
}
